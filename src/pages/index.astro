---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import GitGraph from '../components/GitGraph.astro';
import Products from '../components/Products.astro';
import Mission from '../components/Mission.astro';
import Capabilities from '../components/Capabilities.astro';
import OpenSource from '../components/OpenSource.astro';
import Founder from '../components/Founder.astro';
import Contact from '../components/Contact.astro';
import { getUI } from '../i18n';

const ui = getUI('es');
---

<BaseLayout
  lang="es"
  title="ODALX — Luis Angel Valencia Valera · Fundador & Fullstack Developer"
  description="ODALX, el laboratorio de software de Luis Angel Valencia Valera (Venezuela). Productos en desarrollo: ARGOS, plataforma cuantitativa de trading; toon-memory, memoria MCP para agentes de IA; Atrio, núcleo ERP multi-tenant."
  ui={ui}
>
  <Hero ui={ui} />
  <GitGraph ui={ui} />
  <Products ui={ui} lang="es" />
  <Mission ui={ui} />
  <Capabilities ui={ui} />
  <OpenSource ui={ui} lang="es" />
  <Founder ui={ui} />
  <Contact ui={ui} />
</BaseLayout>
