---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import GitGraph from '../../components/GitGraph.astro';
import Products from '../../components/Products.astro';
import Mission from '../../components/Mission.astro';
import Capabilities from '../../components/Capabilities.astro';
import OpenSource from '../../components/OpenSource.astro';
import Founder from '../../components/Founder.astro';
import Contact from '../../components/Contact.astro';
import { getUI } from '../../i18n';

const ui = getUI('en');
---

<BaseLayout
  lang="en"
  title="ODALX — Luis Angel Valencia Valera · Founder & Fullstack Developer"
  description="ODALX, the software laboratory of Luis Angel Valencia Valera (Venezuela). Products in development: ARGOS, a quantitative trading platform; toon-memory, MCP memory for AI agents; Atrio, a multi-tenant ERP core."
  ui={ui}
>
  <Hero ui={ui} />
  <GitGraph ui={ui} />
  <Products ui={ui} lang="en" />
  <Mission ui={ui} />
  <Capabilities ui={ui} />
  <OpenSource ui={ui} lang="en" />
  <Founder ui={ui} />
  <Contact ui={ui} />
</BaseLayout>
