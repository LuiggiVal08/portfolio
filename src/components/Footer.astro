---
import type { UI } from '../i18n';
import OdalxLogo from './OdalxLogo.astro';

interface Props {
  ui: UI;
}

const { ui } = Astro.props;
const githubUrl = 'https://github.com/LuiggiVal08';
---

<footer class="pb-12 pt-8">
  <div class="container-x">
    <p
      class="max-w-[28ch] font-display text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white"
      data-reveal
    >
      {ui.footer.statement}
    </p>

    <div
      class="mt-10 flex flex-wrap items-center justify-between gap-4 border-t border-slate-900/10 pt-6 dark:border-white/8"
      data-reveal
    >
      <div class="flex items-center gap-2.5">
        <OdalxLogo class="h-5 w-5" />
        <span class="wordmark text-xs text-slate-900 dark:text-white">ODALX</span>
      </div>
      <p class="font-mono text-xs text-slate-500 dark:text-slate-400">{ui.footer.line}</p>
    </div>

    <div class="mt-3 flex flex-wrap items-center justify-between gap-2">
      <p class="font-mono text-[0.7rem] text-slate-400 dark:text-slate-500">{ui.footer.built}</p>
      <a
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="font-mono text-[0.7rem] text-slate-400 transition-colors hover:text-cyan-glow dark:text-slate-500"
      >
        github.com/LuiggiVal08
      </a>
    </div>
  </div>
</footer>
