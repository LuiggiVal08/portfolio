---
import type { UI } from '../i18n';

interface Props {
  ui: UI;
}

const { ui } = Astro.props;
---

<section id="habilidades" class="scroll-mt-28 py-24 sm:py-32">
  <div class="container-x">
    <div class="mb-14 max-w-2xl" data-reveal>
      <p class="eyebrow">{ui.skills.kicker}</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">
        {ui.skills.title}
      </h2>
      <p class="mt-3 max-w-xl text-slate-600 dark:text-slate-300">{ui.skills.subtitle}</p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        ui.skills.groups.map((group, i) => (
          <div class="card glow-hover p-6" data-reveal style={`transition-delay: ${i * 80}ms`}>
            <h3 class="font-mono text-xs font-medium uppercase tracking-[0.16em] text-cyan-glow">
              {group.label}
            </h3>
            <ul class="mt-4 space-y-2.5">
              {group.items.map((item) => (
                <li class="flex items-baseline gap-2 text-sm text-slate-600 dark:text-slate-300">
                  <span class="h-1.5 w-1.5 shrink-0 translate-y-[-1px] rounded-full bg-cyan-glow"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
