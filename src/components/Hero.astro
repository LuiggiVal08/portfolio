---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';
import type { UI } from '../i18n';

interface Props {
  ui: UI;
}

const { ui } = Astro.props;
---

<section data-tree class="relative flex min-h-svh flex-col justify-center overflow-hidden">
  <div class="container-x pt-28 pb-16 sm:pt-32">
      <div class="flex flex-col items-center gap-12 lg:flex-row lg:items-center lg:justify-between" data-tree-anchor>
      <div class="order-2 flex flex-col items-start gap-7 lg:order-1 lg:max-w-4xl">
        <p class="eyebrow" data-reveal>{ui.hero.eyebrow}</p>

        <div class="flex flex-wrap items-end gap-x-6 gap-y-2" data-reveal>
          <h1 class="display-xl text-slate-900 dark:text-white">
            ODALX<span class="text-accent">.</span>
          </h1>
        </div>

        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 font-mono text-sm" data-reveal>
          <span class="text-accent">{ui.hero.founder}</span>
          <span class="text-slate-500 dark:text-slate-400">— {ui.hero.signature}</span>
        </div>

        <p class="max-w-xl text-base leading-relaxed text-slate-600 dark:text-slate-300 sm:text-lg" data-reveal>
          <span class="font-semibold text-slate-900 dark:text-white">{ui.hero.valueProp}</span>{' '}
          {ui.hero.tagline}
        </p>

        <div class="flex flex-wrap items-center gap-3" data-reveal>
          {ui.hero.meta.map((item) => (
            <span class="chip tabular">{item}</span>
          ))}
        </div>

        <div class="flex flex-wrap items-center gap-3" data-reveal>
          <a href="#productos" class="btn btn-primary px-6 py-3 text-sm">
            {ui.hero.ctaProducts}
            <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" />
            </svg>
          </a>
          <a href="#contacto" class="btn btn-ghost px-6 py-3 text-sm">
            {ui.hero.ctaContact}
          </a>
        </div>
      </div>

      <div class="order-1 shrink-0 lg:order-2" data-reveal>
        <div
          class="rounded-full p-[3px]"
          style="background: linear-gradient(135deg, var(--color-cyan-glow), var(--color-violet-glow)); box-shadow: 0 0 44px -10px color-mix(in srgb, var(--color-cyan-glow) 40%, transparent);"
        >
          <Image
            src={avatar}
            alt="Luis Angel Valencia Valera"
            width={460}
            height={460}
            sizes="(min-width: 1024px) 12rem, 8rem"
            class="h-32 w-32 rounded-full object-cover sm:h-36 sm:w-36 lg:h-48 lg:w-48"
          />
        </div>
      </div>
    </div>
  </div>
</section>

