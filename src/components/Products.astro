---
import { getCollection } from 'astro:content';
import type { Locale, UI } from '../i18n';

interface Props {
  ui: UI;
  lang: Locale;
}

const { ui, lang } = Astro.props;

const allProjects = await getCollection('projects', ({ id }) => id.startsWith(`${lang}/`));
const order = ['argos', 'toon-memory', 'atrio-erp'];

const projects = allProjects
  .map((p) => ({ ...p.data, slug: p.id.split('/').pop() ?? '' }))
  .sort((a, b) => order.indexOf(a.slug) - order.indexOf(b.slug));
---

<section id="productos" data-tree class="scroll-mt-28 py-24 sm:py-32">
  <div class="container-x">
    <div class="mb-14 max-w-2xl" data-reveal>
      <p class="eyebrow">{ui.products.kicker}</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">
        {ui.products.title}
      </h2>
      <p class="mt-3 max-w-xl text-slate-600 dark:text-slate-300">{ui.products.subtitle}</p>
    </div>

    <div class="flex flex-col gap-20">
      {
        projects.map((project, i) => (
          <article id={project.slug} class="grid gap-10 lg:grid-cols-2 lg:gap-14" data-reveal>
            <div class="flex flex-col">
              <div class="mb-3 flex items-center justify-between gap-3">
                <span class="font-mono text-xs uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400">
                  {String(i + 1).padStart(2, '0')} / {ui.products.kicker}
                </span>
                {project.status === 'in-development' ? (
                  <span class="rounded-full border border-violet-glow/40 bg-violet-glow/10 px-2.5 py-0.5 font-mono text-[0.65rem] uppercase tracking-wide text-violet-glow">
                    {ui.products.inDevelopment}
                  </span>
                ) : (
                  <span class="rounded-full border border-cyan-glow/40 bg-cyan-glow/10 px-2.5 py-0.5 font-mono text-[0.65rem] uppercase tracking-wide text-cyan-glow">
                    {ui.products.published}
                  </span>
                )}
              </div>

              <h3 class="font-display text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
                {project.title}
              </h3>
              <p class="mt-1.5 font-mono text-sm text-cyan-glow">{project.tagline}</p>

              <p class="mt-5 text-sm leading-relaxed text-slate-600 dark:text-slate-300 sm:text-base">
                {project.description}
              </p>

              {project.metrics.length > 0 && (
                <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
                  {project.metrics.map((m) => (
                    <div class="card px-3 py-3.5">
                      <p class="tabular font-display text-xl font-bold text-slate-900 dark:text-white">
                        {m.value}
                      </p>
                      <p class="mt-0.5 text-[0.7rem] leading-tight text-slate-500 dark:text-slate-400">
                        {m.label}
                      </p>
                    </div>
                  ))}
                </div>
              )}

              <div class="mt-7">
                <h4 class="font-mono text-xs font-medium uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">
                  {ui.products.features}
                </h4>
                <ul class="mt-3 space-y-2">
                  {project.features.map((f) => (
                    <li class="flex items-baseline gap-2 text-sm text-slate-600 dark:text-slate-300">
                      <span class="h-1.5 w-1.5 shrink-0 translate-y-[-1px] rounded-full bg-cyan-glow"></span>
                      {f}
                    </li>
                  ))}
                </ul>
              </div>

              <div class="mt-7">
                <h4 class="font-mono text-xs font-medium uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">
                  {ui.products.roadmap}
                </h4>
                <ul class="mt-3 space-y-2">
                  {project.milestones.map((m) => (
                    <li class="flex items-center gap-2.5 text-sm text-slate-600 dark:text-slate-300">
                      {m.done ? (
                        <span class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-cyan-glow text-[0.6rem] font-bold text-ink-950">✓</span>
                      ) : (
                        <span class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full border border-slate-900/20 dark:border-white/20"></span>
                      )}
                      <span class={m.done ? 'text-slate-400 dark:text-slate-500' : ''}>{m.label}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="mt-8 flex items-center gap-5">
                <a
                  href={project.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link-arrow text-sm"
                >
                  {ui.products.viewCode}
                  <span class="arrow">→</span>
                </a>
                {project.demo && (
                  <a
                    href={project.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-arrow text-sm"
                  >
                    {ui.products.viewDocs}
                    <span class="arrow">↗</span>
                  </a>
                )}
                {project.stars !== undefined && (
                  <span class="tabular font-mono text-xs text-slate-500 dark:text-slate-400">
                    ★ {project.stars}
                  </span>
                )}
              </div>
            </div>

            <div class="flex flex-col">
              <h4 class="mb-3 font-mono text-xs font-medium uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">
                {ui.products.architecture}
              </h4>
              <pre
                class="card flex-1 overflow-x-auto p-5 font-mono text-xs leading-6 sm:p-6 sm:text-[0.8rem]"
                style="white-space: pre;"
              >{project.architecture.join('\n')}</pre>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
