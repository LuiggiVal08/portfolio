---
import type { UI } from '../i18n';

interface Props {
  ui: UI;
}

const { ui } = Astro.props;
const githubUrl = 'https://github.com/LuiggiVal08';
---

<section id="contacto" data-tree class="scroll-mt-28 py-24 sm:py-32">
  <div class="container-x">
    <div class="card glow-hover flex flex-col items-start gap-6 p-8 sm:p-12" data-reveal>
      <p class="eyebrow">{ui.contact.kicker}</p>
      <h2 class="font-display text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
        {ui.contact.title}
      </h2>
      <p class="max-w-md text-slate-600 dark:text-slate-300">{ui.contact.subtitle}</p>

      <a
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary mt-2 px-7 py-3.5 text-sm"
      >
        <svg viewBox="0 0 24 24" class="h-4.5 w-4.5" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.7 1.25 3.35.96.11-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.25 5.68.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.2.66.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z" />
        </svg>
        {ui.contact.githubCta}
      </a>

      <p class="font-mono text-xs text-slate-500 dark:text-slate-400">
        <span class="text-cyan-glow">@</span>
        {ui.contact.handle}
      </p>
    </div>
  </div>
</section>
