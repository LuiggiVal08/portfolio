---
import type { UI } from '../i18n';

interface Props {
  ui: UI;
}

const { ui } = Astro.props;
---

<section id="odalx" class="scroll-mt-28 py-24 sm:py-32">
  <div class="container-x">
    <div class="mb-12 max-w-2xl" data-reveal>
      <p class="eyebrow">{ui.mission.kicker}</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">
        {ui.mission.title}
      </h2>
    </div>

    <div class="grid gap-6 md:grid-cols-2" data-reveal>
      <div class="card glow-hover p-7 sm:p-8">
        <p class="font-display text-3xl text-cyan-glow">ᛟ</p>
        <h3 class="mt-3 font-display text-lg font-bold text-slate-900 dark:text-white">
          Odal
        </h3>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">{ui.mission.runeOdal}</p>
      </div>
      <div class="card glow-hover p-7 sm:p-8">
        <p class="font-display text-3xl text-violet-glow">ᚷ</p>
        <h3 class="mt-3 font-display text-lg font-bold text-slate-900 dark:text-white">
          Gebo
        </h3>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">{ui.mission.runeGebo}</p>
      </div>
    </div>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-300 sm:text-base" data-reveal>
        {ui.mission.p1}
      </p>
      <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-300 sm:text-base" data-reveal>
        {ui.mission.p2}
      </p>
    </div>

    <blockquote
      class="mt-14 max-w-3xl font-display text-2xl font-bold leading-snug tracking-tight text-slate-900 sm:text-3xl dark:text-white"
      data-reveal
    >
      <span class="text-accent">“</span>
      {ui.mission.quote}
      <span class="text-accent">”</span>
    </blockquote>
  </div>
</section>
