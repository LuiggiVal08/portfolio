---
import { getCollection } from 'astro:content';
import type { Locale, UI } from '../i18n';

interface Props {
  ui: UI;
  lang: Locale;
}

const { ui, lang } = Astro.props;

const allProjects = await getCollection('projects', ({ id }) => id.startsWith(`${lang}/`));
const order = ['argos', 'toon-memory', 'atrio-erp'];

const projects = allProjects
  .map((p) => ({ ...p.data, slug: p.id.split('/').pop() ?? '' }))
  .sort((a, b) => order.indexOf(a.slug) - order.indexOf(b.slug));

const repoBase = 'https://github.com/LuiggiVal08';
---

<section id="construyo" data-tree class="scroll-mt-28 py-24 sm:py-32">
  <div class="container-x xl:grid xl:grid-cols-[1fr_11rem_1fr] xl:items-start xl:gap-14">
    <div class="xl:col-start-1" data-reveal data-tree-anchor>
      <p class="eyebrow">{ui.capabilities.kicker}</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">
        {ui.capabilities.title}<span class="cursor" aria-hidden="true"></span>
      </h2>
      <p class="mt-3 max-w-xl text-slate-600 dark:text-slate-300">{ui.capabilities.subtitle}</p>
      <p class="mt-6 font-mono text-xs text-slate-400 dark:text-slate-500">
        {ui.capabilities.note}
      </p>

      <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-1">
        {
          ui.capabilities.items.map((item, i) => (
            <div class="card glow-hover p-6" data-reveal style={`transition-delay: ${i * 70}ms`}>
              <p class="font-mono text-xs text-slate-400 dark:text-slate-500">
                {String(i + 1).padStart(2, '0')}
              </p>
              <h3 class="mt-2 font-display text-lg font-bold text-slate-900 dark:text-white">
                {item.title}
              </h3>
              <p class="mt-1.5 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
                {item.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-12 xl:col-start-3 xl:mt-0" data-reveal data-tree-anchor>
      <p class="eyebrow">{ui.opensource.kicker}</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">
        {ui.opensource.title}<span class="cursor" aria-hidden="true"></span>
      </h2>
      <p class="mt-3 max-w-xl text-slate-600 dark:text-slate-300">{ui.opensource.subtitle}</p>

      <div class="mt-8 flex flex-col divide-y divide-slate-900/10 dark:divide-white/8">
        {
          projects.map((project, i) => (
            <div
              class="group grid grid-cols-1 items-center gap-3 py-6 sm:grid-cols-[2.5rem_1fr_auto] sm:gap-6"
              data-reveal
              style={`transition-delay: ${i * 70}ms`}
            >
              <span class="hidden font-mono text-xs text-slate-400 sm:block dark:text-slate-500">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <a
                  href={project.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-display text-lg font-bold text-slate-900 transition-colors group-hover:text-cyan-glow dark:text-white"
                >
                  {project.title}
                  <span class="arrow inline-block pl-1 text-cyan-glow opacity-0 transition-opacity duration-200 group-hover:opacity-100">↗</span>
                </a>
                <p class="mt-0.5 text-sm text-slate-600 dark:text-slate-300">{project.tagline}</p>
              </div>
              <div class="flex flex-wrap items-center gap-2">
                {project.stars !== undefined && (
                  <span class="chip tabular">★ {project.stars} {ui.opensource.stars}</span>
                )}
                {project.slug === 'toon-memory' && (
                  <>
                    <span class="chip">{ui.opensource.npm}</span>
                    <span class="chip">{ui.opensource.registry}</span>
                  </>
                )}
                <a
                  href={project.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-ghost px-4 py-2 text-xs"
                >
                  {ui.opensource.viewRepo}
                </a>
              </div>
            </div>
          ))
        }
      </div>

      <p class="mt-8 font-mono text-xs text-slate-500 dark:text-slate-400" data-reveal>
        <a href={repoBase} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-cyan-glow">
          github.com/LuiggiVal08 →
        </a>
      </p>
    </div>
  </div>
</section>