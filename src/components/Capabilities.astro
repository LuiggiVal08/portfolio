---
import type { UI } from '../i18n';

interface Props {
  ui: UI;
}

const { ui } = Astro.props;
---

<section id="capacidades" class="scroll-mt-28 py-24 sm:py-32">
  <div class="container-x">
    <div class="mb-14 max-w-2xl" data-reveal>
      <p class="eyebrow">{ui.capabilities.kicker}</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">
        {ui.capabilities.title}
      </h2>
      <p class="mt-3 max-w-xl text-slate-600 dark:text-slate-300">{ui.capabilities.subtitle}</p>
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        ui.capabilities.items.map((item, i) => (
          <div class="card glow-hover p-6" data-reveal style={`transition-delay: ${i * 70}ms`}>
            <p class="font-mono text-xs text-slate-400 dark:text-slate-500">
              {String(i + 1).padStart(2, '0')}
            </p>
            <h3 class="mt-2 font-display text-lg font-bold text-slate-900 dark:text-white">
              {item.title}
            </h3>
            <p class="mt-1.5 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
              {item.description}
            </p>
          </div>
        ))
      }
    </div>

    <p class="mt-6 font-mono text-xs text-slate-500 dark:text-slate-400" data-reveal>
      {ui.capabilities.note}
    </p>
  </div>
</section>
