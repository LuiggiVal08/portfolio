---
import type { Locale, UI } from '../i18n';
import OdalxLogo from './OdalxLogo.astro';
import ThemeToggle from './ThemeToggle.tsx';

interface Props {
  ui: UI;
  lang: Locale;
}

const { ui, lang } = Astro.props;

const base = import.meta.env.BASE_URL;
const home = base.endsWith('/') ? base : `${base}/`;
const alternateUrl = lang === 'es' ? `${home}en/` : home;
const alternateLabel = lang === 'es' ? 'English' : 'Español';
const githubUrl = 'https://github.com/LuiggiVal08';
---

<nav class="fixed inset-x-0 top-4 z-40 flex justify-center px-4" aria-label="Principal">
  <div
    class="flex items-center gap-2 rounded-full border border-slate-900/10 bg-white/80 py-1.5 pl-2 pr-1.5 shadow-lg shadow-slate-900/5 backdrop-blur-xl transition-colors duration-300 sm:gap-3 sm:pl-3 dark:border-white/10 dark:bg-ink-900/70 dark:shadow-black/30"
    style="max-width: calc(100vw - 2rem)"
  >
    <a
      href={home}
      class="flex items-center gap-2 rounded-full px-1.5 py-1 transition-opacity hover:opacity-80"
      aria-label="ODALX — {ui.hero.signature}"
    >
      <OdalxLogo class="h-6 w-6 shrink-0" />
      <span class="wordmark hidden text-sm text-slate-900 sm:inline dark:text-white">ODALX</span>
    </a>

    <div class="hidden items-center gap-1 md:flex">
      <a href="#productos" class="rounded-full px-3 py-1.5 text-sm font-medium text-slate-600 transition-colors hover:bg-slate-900/5 hover:text-cyan-glow dark:text-slate-300 dark:hover:bg-white/5">
        {ui.nav.products}
      </a>
      <a href="#odalx" class="rounded-full px-3 py-1.5 text-sm font-medium text-slate-600 transition-colors hover:bg-slate-900/5 hover:text-cyan-glow dark:text-slate-300 dark:hover:bg-white/5">
        {ui.nav.odalx}
      </a>
      <a href="#founder" class="rounded-full px-3 py-1.5 text-sm font-medium text-slate-600 transition-colors hover:bg-slate-900/5 hover:text-cyan-glow dark:text-slate-300 dark:hover:bg-white/5">
        {ui.nav.contact}
      </a>
    </div>

    <div class="ml-auto flex items-center gap-0.5 sm:ml-0">
      <a
        href={alternateUrl}
        hreflang={lang === 'es' ? 'en' : 'es'}
        class="rounded-full px-2.5 py-1.5 font-mono text-xs font-medium text-slate-500 transition-colors hover:text-cyan-glow dark:text-slate-400"
      >
        {alternateLabel}
      </a>

      <ThemeToggle client:load />

      <a
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub — LuiggiVal08"
        class="flex h-9 w-9 items-center justify-center rounded-full text-slate-600 transition-colors hover:text-cyan-glow dark:text-slate-300"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.7 1.25 3.35.96.11-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.25 5.68.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.2.66.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z" />
        </svg>
      </a>
    </div>
  </div>
</nav>
