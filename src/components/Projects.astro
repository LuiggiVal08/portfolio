---
import { getCollection } from 'astro:content';
import type { Locale, UI } from '../i18n';

interface Props {
  ui: UI;
  lang: Locale;
}

const { ui, lang } = Astro.props;

const allProjects = await getCollection('projects', ({ id }) => id.startsWith(`${lang}/`));
const order = ['toon-memory', 'argos-ats', 'atrio-erp'];

const projects = allProjects
  .map((p) => ({ ...p.data, slug: p.id.split('/').pop() ?? '' }))
  .sort((a, b) => order.indexOf(a.slug) - order.indexOf(b.slug));

const repoBase = 'https://github.com/LuiggiVal08';
---

<section id="proyectos" class="scroll-mt-28 py-24 sm:py-32">
  <div class="container-x">
    <div class="mb-14 max-w-2xl" data-reveal>
      <p class="eyebrow">{ui.projects.kicker}</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">
        {ui.projects.title}
      </h2>
      <p class="mt-3 max-w-xl text-slate-600 dark:text-slate-300">{ui.projects.subtitle}</p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((project, i) => (
          <article
            class="card glow-hover flex flex-col p-6"
            data-reveal
            style={`transition-delay: ${i * 90}ms`}
          >
            <div class="mb-4 flex items-center justify-between gap-3">
              <span class="font-mono text-xs uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400">
                {String(i + 1).padStart(2, '0')}
              </span>
              {project.status === 'in-development' ? (
                <span class="rounded-full border border-violet-glow/40 bg-violet-glow/10 px-2.5 py-0.5 font-mono text-[0.65rem] uppercase tracking-wide text-violet-glow">
                  {ui.projects.inDevelopment}
                </span>
              ) : (
                <span class="rounded-full border border-cyan-glow/40 bg-cyan-glow/10 px-2.5 py-0.5 font-mono text-[0.65rem] uppercase tracking-wide text-cyan-glow">
                  {project.title === 'toon-memory' ? 'MCP Registry' : 'Live'}
                </span>
              )}
            </div>

            <h3 class="font-display text-xl font-bold tracking-tight text-slate-900 dark:text-white">
              {project.title}
            </h3>

            <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
              {project.longDescription ?? project.description}
            </p>

            <div class="mt-5 flex flex-wrap gap-1.5">
              {project.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>

            <div class="mt-5 flex items-center justify-between border-t border-slate-900/10 pt-4 dark:border-white/8">
              <a
                href={project.repo}
                target="_blank"
                rel="noopener noreferrer"
                class="link-arrow text-sm"
              >
                {ui.projects.viewCode}
                <span class="arrow">→</span>
              </a>
              <span class="flex items-center gap-3">
                {project.demo && (
                  <a
                    href={project.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-arrow text-sm"
                  >
                    {ui.projects.viewDemo}
                    <span class="arrow">↗</span>
                  </a>
                )}
                {project.stars !== undefined && (
                  <span class="tabular font-mono text-xs text-slate-500 dark:text-slate-400">
                    ★ {project.stars}
                  </span>
                )}
              </span>
            </div>
          </article>
        ))
      }
    </div>

    <p class="mt-8 font-mono text-xs text-slate-500 dark:text-slate-400" data-reveal>
      <a href={repoBase} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-cyan-glow">
        github.com/LuiggiVal08 →
      </a>
    </p>
  </div>
</section>
