---

<div class="tree" aria-hidden="true">
  <svg id="tree-svg" xmlns="http://www.w3.org/2000/svg"></svg>
</div>

<script is:inline>
  (function () {
    var svg = document.getElementById('tree-svg');
    if (!svg) return;
    var S = svg;
    var NS = 'http://www.w3.org/2000/svg';
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function makeEl(name, attrs) {
      var el = document.createElementNS(NS, name);
      Object.keys(attrs).forEach(function (k) {
        el.setAttribute(k, attrs[k]);
      });
      S.appendChild(el);
      return el;
    }

    function easeOutCubic(t) {
      return 1 - Math.pow(1 - t, 3);
    }

    function cluster(ys, tol) {
      ys.sort(function (a, b) { return a - b; });
      var out = [];
      var cur = [ys[0]];
      for (var i = 1; i < ys.length; i += 1) {
        if (ys[i] - cur[cur.length - 1] < tol) {
          cur.push(ys[i]);
        } else {
          out.push(cur.reduce(function (s, v) { return s + v; }, 0) / cur.length);
          cur = [ys[i]];
        }
      }
      out.push(cur.reduce(function (s, v) { return s + v; }, 0) / cur.length);
      return out;
    }

    function build() {
      while (S.firstChild) S.removeChild(S.firstChild);

      var w = Math.max(320, document.documentElement.clientWidth);
      if (w < 1280) {
        S.style.display = 'none';
        return;
      }
      S.style.display = '';

      var docH = document.documentElement.scrollHeight;
      var sy = window.scrollY;

      S.setAttribute('width', String(w));
      S.setAttribute('height', String(docH));
      S.setAttribute('viewBox', '0 0 ' + w + ' ' + docH);

      var sections = Array.prototype.slice.call(
        document.querySelectorAll('section[data-tree]')
      );
      if (sections.length < 2) return;

      var centerX = w / 2;
      var sects = [];
      var minY = Infinity;
      var maxY = -Infinity;

      sections.forEach(function (sec, si) {
        if (si === 0) return;
        var cont = sec.querySelector('.container-x');
        if (!cont) return;
        var items = Array.prototype.filter.call(cont.children, function (el) {
          return el.hasAttribute('data-tree-anchor');
        });
        if (!items.length) return;

        var g = makeEl('g', { class: 'tree-group' });
        var seq = [];
        var firstY = Infinity;
        var lastY = -Infinity;

        items.forEach(function (item) {
          var r = item.getBoundingClientRect();
          var absTop = r.top + sy;
          var absBottom = r.bottom + sy;
          var h = item.offsetHeight;
          var cy = absTop + h / 2;

          var dots = [];
          dots.push(makeEl('circle', {
            cx: centerX, cy: cy, r: 5,
            class: 'tree-commit tree-commit-trunk',
          }));

          var path = null;
          var lane = null;

          if (h > 110) {
            var side = r.left + r.width / 2 < centerX ? -1 : 1;
            lane = centerX + side * 22;

            path = makeEl('path', {
              d:
                'M ' + centerX + ' ' + absTop +
                ' C ' + (centerX + side * 20) + ' ' + absTop +
                ', ' + lane + ' ' + (absTop + 10) +
                ', ' + lane + ' ' + (absTop + 22) +
                ' L ' + lane + ' ' + (absBottom - 22) +
                ' C ' + lane + ' ' + (absBottom - 10) +
                ', ' + (centerX + side * 20) + ' ' + absBottom +
                ', ' + centerX + ' ' + absBottom,
              class: 'tree-branch',
            });
            var pl = path.getTotalLength();
            path.style.strokeDasharray = String(pl);
            path.style.strokeDashoffset = String(pl);

            var subs = Array.prototype.slice.call(
              item.querySelectorAll('h2, h3, h4')
            ).map(function (el) {
              var cr = el.getBoundingClientRect();
              return cr.top + sy + cr.height / 2;
            });
            if (subs.length) {
              subs = cluster(subs, 90).filter(function (y) {
                return y >= absTop + 24 && y <= absBottom - 24;
              });
            }
            if (!subs.length) subs = [cy];
            subs.forEach(function (y) {
              dots.push(makeEl('circle', {
                cx: lane, cy: y, r: 5,
                class: 'tree-commit tree-commit-branch',
              }));
            });
          }

          seq.push({ p: path, dots: dots });
          if (cy < firstY) firstY = cy;
          if (cy > lastY) lastY = cy;
        });

        S.appendChild(g);
        sects.push({ sec: sec, g: g, seq: seq, firstY: firstY, lastY: lastY });
        if (firstY < minY) minY = firstY;
        if (lastY > maxY) maxY = lastY;
      });

      if (!isFinite(minY)) return;

      makeEl('path', {
        d: 'M ' + centerX + ' ' + (minY - 40) + ' L ' + centerX + ' ' + (maxY + 60),
        class: 'tree-trunk',
      });

      function drawAll() {
        sects.forEach(function (pair) {
          pair.seq.forEach(function (s) {
            if (s.p) s.p.style.strokeDashoffset = '0';
            s.dots.forEach(function (d) {
              d.style.opacity = '1';
            });
          });
        });
      }

      if (reduce || !('IntersectionObserver' in window)) {
        sects.forEach(function (p) {
          p.g.classList.add('in-view');
        });
        drawAll();
        return;
      }

      var obs = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (en) {
            if (!en.isIntersecting) return;
            var hit = null;
            sects.forEach(function (p) {
              if (p.sec === en.target) hit = p;
            });
            if (!hit) return;
            hit.g.classList.add('in-view');
            obs.unobserve(en.target);

            hit.seq.forEach(function (s, i) {
              if (s.p) {
                setTimeout(function () {
                  var from = parseFloat(s.p.style.strokeDashoffset);
                  var start = null;
                  function tick(now) {
                    if (start === null) start = now;
                    var t = Math.min(1, (now - start) / 800);
                    s.p.style.strokeDashoffset = String(from * (1 - easeOutCubic(t)));
                    if (t < 1) {
                      requestAnimationFrame(tick);
                    } else {
                      s.dots.forEach(function (d, j) {
                        setTimeout(function () {
                          d.style.opacity = '1';
                        }, 100 + j * 110);
                      });
                    }
                  }
                  requestAnimationFrame(tick);
                }, i * 140);
              } else {
                setTimeout(function () {
                  s.dots.forEach(function (d, j) {
                    setTimeout(function () {
                      d.style.opacity = '1';
                    }, j * 90);
                  });
                }, i * 140);
              }
            });
          });
        },
        { threshold: 0.2 }
      );

      sects.forEach(function (p) {
        obs.observe(p.sec);
      });
    }

    build();

    window.addEventListener('resize', function () {
      build();
    });
    window.addEventListener('load', function () {
      build();
    });
    setTimeout(build, 800);
  })();
</script>