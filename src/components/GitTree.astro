---

---

<div class="tree" aria-hidden="true">
  <svg id="tree-svg" xmlns="http://www.w3.org/2000/svg"></svg>
</div>

<script is:inline>
  (function () {
    var svg = document.getElementById('tree-svg');
    if (!svg) return;
    var S = svg;
    var NS = 'http://www.w3.org/2000/svg';
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function makeEl(name, attrs) {
      var el = document.createElementNS(NS, name);
      Object.keys(attrs).forEach(function (k) {
        el.setAttribute(k, attrs[k]);
      });
      S.appendChild(el);
      return el;
    }

    function cluster(ys, tol) {
      ys.sort(function (a, b) { return a - b; });
      var out = [];
      var cur = [ys[0]];
      for (var i = 1; i < ys.length; i += 1) {
        if (ys[i] - cur[cur.length - 1] < tol) {
          cur.push(ys[i]);
        } else {
          out.push(cur.reduce(function (s, v) { return s + v; }, 0) / cur.length);
          cur = [ys[i]];
        }
      }
      out.push(cur.reduce(function (s, v) { return s + v; }, 0) / cur.length);
      return out;
    }

    function build() {
      while (S.firstChild) S.removeChild(S.firstChild);

      var w = Math.max(320, document.documentElement.clientWidth);
      if (w < 1280) {
        S.style.display = 'none';
        return;
      }
      S.style.display = '';

      var docH = document.documentElement.scrollHeight;
      var sy = window.scrollY;

      S.setAttribute('width', String(w));
      S.setAttribute('height', String(docH));
      S.setAttribute('viewBox', '0 0 ' + w + ' ' + docH);

      var sections = Array.prototype.slice.call(
        document.querySelectorAll('section[data-tree]')
      );
      if (sections.length < 2) return;

      var centerX = w / 2;
      var sects = [];
      var minY = Infinity;
      var maxY = -Infinity;
      var chainSide = -1;
      var oppTick = 0;

      function oppBranch(seq, originY, laneSign) {
        var oH = 270;
        var y0 = originY;
        var y2 = y0 + oH;
        var oLane = centerX + laneSign * 28;
        var oTurn = Math.max(34, Math.min(54, 28 * 1.1));
        var oA = oTurn * 0.5;
        var p = makeEl('path', {
          d:
            'M ' + centerX + ' ' + y0 +
            ' C ' + centerX + ' ' + (y0 + oA) +
            ', ' + oLane + ' ' + (y0 + oTurn - oA) +
            ', ' + oLane + ' ' + (y0 + oTurn) +
            ' L ' + oLane + ' ' + (y2 - oTurn) +
            ' C ' + oLane + ' ' + (y2 - oTurn + oA) +
            ', ' + centerX + ' ' + (y2 - oA) +
            ', ' + centerX + ' ' + y2,
          class: 'tree-branch',
        });
        var pl = p.getTotalLength();
        p.style.strokeDasharray = String(pl);
        p.style.strokeDashoffset = String(pl);
        var dots = [];
        var ia = y0 + oTurn + 14;
        var ib = y2 - oTurn - 14;
        var span = ib - ia;
        if (span > 30) {
          dots.push(makeEl('circle', {
            cx: oLane, cy: ia + span * 0.25, r: 4.5,
            class: 'tree-commit tree-commit-branch',
          }));
          dots.push(makeEl('circle', {
            cx: oLane, cy: ia + span * 0.7, r: 4.5,
            class: 'tree-commit tree-commit-branch',
          }));
        }
        dots.push(makeEl('circle', {
          cx: centerX, cy: y2, r: 12,
          class: 'tree-halo tree-halo-cyan',
        }));
        dots.push(makeEl('circle', {
          cx: centerX, cy: y2, r: 7,
          class: 'tree-commit tree-commit-branch tree-commit-merge tree-commit-merge-cyan',
        }));
        seq.push({ p: p, dots: dots, top: y0, bottom: y2, len: pl });
      }

      sections.forEach(function (sec, si) {
        if (si === 0) return;
        var cont = sec.querySelector('.container-x');
        if (!cont) return;
        var items = Array.prototype.filter.call(cont.children, function (el) {
          return el.hasAttribute('data-tree-anchor');
        });
        if (!items.length) return;

        var g = makeEl('g', { class: 'tree-group' });
        var seq = [];
        var firstY = Infinity;
        var lastY = -Infinity;

        if (si >= 2) {
          var topP = Infinity;
          var botP = -Infinity;
          var mids = [];
          var secDots = [];
          var cys = [];
          items.forEach(function (item) {
            var r = item.getBoundingClientRect();
            var absTop = r.top + sy;
            var absBottom = r.bottom + sy;
            var cy = absTop + item.offsetHeight / 2;
            if (absTop < topP) topP = absTop;
            if (absBottom > botP) botP = absBottom;
            cys.push(cy);
            if (cy < firstY) firstY = cy;
            if (cy > lastY) lastY = cy;
          });
          if (topP < Infinity && botP > -Infinity) {
            chainSide = -chainSide;
            var cLane = centerX + chainSide * 28;
            var cTurn = Math.max(40, Math.min(80, 28 * 1.4));
            var cA = cTurn * 0.5;
            var cP = makeEl('path', {
              d:
                'M ' + centerX + ' ' + topP +
                ' C ' + centerX + ' ' + (topP + cA) +
                ', ' + cLane + ' ' + (topP + cTurn - cA) +
                ', ' + cLane + ' ' + (topP + cTurn) +
                ' L ' + cLane + ' ' + (botP - cTurn) +
                ' C ' + cLane + ' ' + (botP - cTurn + cA) +
                ', ' + centerX + ' ' + (botP - cA) +
                ', ' + centerX + ' ' + botP,
              class: 'tree-branch tree-branch-section',
            });
            var cpl = cP.getTotalLength();
            cP.style.strokeDasharray = String(cpl);
            cP.style.strokeDashoffset = String(cpl);

            secDots.push(makeEl('circle', {
              cx: centerX, cy: topP, r: 4.5,
              class: 'tree-commit tree-commit-branch tree-commit-origin',
            }));
            cys.forEach(function (y) {
              secDots.push(makeEl('circle', {
                cx: cLane, cy: y, r: 5,
                class: 'tree-commit tree-commit-branch',
              }));
            });
            secDots.push(makeEl('circle', {
              cx: centerX, cy: botP, r: 12,
              class: 'tree-halo tree-halo-cyan',
            }));
            secDots.push(makeEl('circle', {
              cx: centerX, cy: botP, r: 7,
              class: 'tree-commit tree-commit-branch tree-commit-merge tree-commit-merge-cyan',
            }));

            seq.push({ p: cP, dots: secDots, top: topP, bottom: botP, len: cpl });
            oppTick += 1;
            if (oppTick % 2 === 1) {
              oppBranch(seq, topP, -chainSide);
            }
            if (topP < minY) minY = topP;
            if (botP > maxY) maxY = botP;
          }
          S.appendChild(g);
          sects.push({ sec: sec, g: g, seq: seq, firstY: firstY, lastY: lastY });
          return;
        }

        items.forEach(function (item, idx) {
          var r = item.getBoundingClientRect();
          var absTop = r.top + sy;
          var absBottom = r.bottom + sy;
          var h = item.offsetHeight;
          var cy = absTop + h / 2;

          var dots = [];
          dots.push(makeEl('circle', {
            cx: centerX, cy: cy, r: 5,
            class: 'tree-commit tree-commit-trunk',
          }));

          var isArticle = item.tagName === 'ARTICLE';
          var path = null;
          var lane = null;

          if (h > 110 && !isArticle) {
            var side = r.left + r.width / 2 < centerX ? -1 : 1;
            var edge = side < 0 ? r.left + r.width : r.left;
            lane = edge - side * 18;

            var cRun = Math.abs(lane - centerX);
            var cTurn = Math.max(22, Math.min(58, cRun * 1.2));
            var cA = cTurn * 0.5;

            path = makeEl('path', {
              d:
                'M ' + centerX + ' ' + absTop +
                ' C ' + centerX + ' ' + (absTop + cA) +
                ', ' + lane + ' ' + (absTop + cTurn - cA) +
                ', ' + lane + ' ' + (absTop + cTurn) +
                ' L ' + lane + ' ' + (absBottom - cTurn) +
                ' C ' + lane + ' ' + (absBottom - cTurn + cA) +
                ', ' + centerX + ' ' + (absBottom - cA) +
                ', ' + centerX + ' ' + absBottom,
              class: 'tree-branch',
            });
            var pl = path.getTotalLength();
            path.style.strokeDasharray = String(pl);
            path.style.strokeDashoffset = String(pl);

            var subs = Array.prototype.slice.call(
              item.querySelectorAll('h2, h3, h4')
            ).map(function (el) {
              var cr = el.getBoundingClientRect();
              return cr.top + sy + cr.height / 2;
            });
            if (subs.length) {
              subs = cluster(subs, 90).filter(function (y) {
                return y >= absTop + cTurn + 10 && y <= absBottom - cTurn - 10;
              });
            }
            if (!subs.length) subs = [cy];
            dots.push(makeEl('circle', {
              cx: centerX, cy: absTop, r: 4.5,
              class: 'tree-commit tree-commit-branch tree-commit-origin',
            }));
            subs.forEach(function (y) {
              dots.push(makeEl('circle', {
                cx: lane, cy: y, r: 5,
                class: 'tree-commit tree-commit-branch',
              }));
            });
            dots.push(makeEl('circle', {
              cx: centerX, cy: absBottom, r: 12,
              class: 'tree-halo tree-halo-cyan',
            }));
            dots.push(makeEl('circle', {
              cx: centerX, cy: absBottom, r: 7,
              class: 'tree-commit tree-commit-branch tree-commit-merge tree-commit-merge-cyan',
            }));
          }

          if (item.tagName === 'ARTICLE') {
            var featSide = idx % 2 === 0 ? 1 : -1;
            var fyT = absTop + 60;
            var fyB = absBottom - 40;
            var seg = fyB - fyT;

            if (seg > 160) {
                var laneHalf = 88;
                f1 = centerX + featSide * 28;
                f1 = Math.max(centerX - laneHalf, Math.min(centerX + laneHalf, f1));
                var f2 = centerX + featSide * 56;
                f2 = Math.max(centerX - laneHalf, Math.min(centerX + laneHalf, f2));

                // La rama y el tronco deben quedar AMBOS del mismo lado de la tarjeta.
                // Forzar f1/f2 al lado del producto del tronco (no cruzar el tronco).
                var fDir = f1 > centerX ? 1 : -1;
                var runX = Math.abs(f1 - centerX);
                var turnY = Math.max(58, Math.min(150, runX * 1.4));
                var arcA = turnY * 0.5;

                var mainP = makeEl('path', {
                  d:
                    'M ' + centerX + ' ' + fyT +
                    ' C ' + centerX + ' ' + (fyT + arcA) +
                    ', ' + f1 + ' ' + (fyT + turnY - arcA) +
                    ', ' + f1 + ' ' + (fyT + turnY) +
                    ' L ' + f1 + ' ' + (fyB - turnY) +
                    ' C ' + f1 + ' ' + (fyB - turnY + arcA) +
                    ', ' + centerX + ' ' + (fyB - arcA) +
                    ', ' + centerX + ' ' + fyB,
                  class: 'tree-branch',
                });
                var mpl = mainP.getTotalLength();
                mainP.style.strokeDasharray = String(mpl);
                mainP.style.strokeDashoffset = String(mpl);

                var fDotTop = fyT + turnY + 12;
                var fDotBot = fyB - turnY - 12;
                var fDotSeg = fDotBot - fDotTop;
                var fDots = [];
                if (fDotSeg > 40) {
                  var mainYs = [];
                  for (var mk = 1; mk <= 6; mk += 1) {
                    mainYs.push(fDotTop + (fDotSeg * mk) / 7);
                  }
                  mainYs.forEach(function (y) {
                    fDots.push(makeEl('circle', {
                      cx: f1, cy: y, r: 4.5,
                      class: 'tree-commit tree-commit-branch',
                    }));
                  });
                }

                seq.push({ p: mainP, dots: fDots, top: fyT, bottom: fyB, len: mpl });
                oppTick += 1;
                if (oppTick % 2 === 0) {
                  oppBranch(seq, fyT, -featSide);
                }

                fDots.push(makeEl('circle', {
                  cx: centerX, cy: fyT, r: 5,
                  class: 'tree-commit tree-commit-branch tree-commit-origin',
                }));
                fDots.push(makeEl('circle', {
                  cx: centerX, cy: fyB, r: 13,
                  class: 'tree-halo tree-halo-violet',
                }));
                fDots.push(makeEl('circle', {
                  cx: centerX, cy: fyB, r: 8,
                  class: 'tree-commit tree-commit-branch tree-commit-merge',
                }));

                var subY = fyT + seg * 0.5;
                var subH = 180;
                if (fyT + turnY + subH * 0.5 <= fyB - turnY - 10) {
                  var subRun = Math.abs(f2 - f1);
                  var subTurn = Math.max(40, Math.min(84, subRun * 1.2));
                  var subA = subTurn * 0.5;
                  var subP = makeEl('path', {
                    d:
                      'M ' + f1 + ' ' + subY +
                      ' C ' + f1 + ' ' + (subY + subA) +
                      ', ' + f2 + ' ' + (subY + subTurn - subA) +
                      ', ' + f2 + ' ' + (subY + subTurn) +
                      ' L ' + f2 + ' ' + (subY + subH - subTurn) +
                      ' C ' + f2 + ' ' + (subY + subH - subTurn + subA) +
                      ', ' + f1 + ' ' + (subY + subH - subA) +
                      ', ' + f1 + ' ' + (subY + subH),
                    class: 'tree-branch tree-branch-sub',
                  });
                  var spl = subP.getTotalLength();
                  subP.style.strokeDasharray = String(spl);
                  subP.style.strokeDashoffset = String(spl);
                  fDots.push(makeEl('circle', {
                    cx: f1, cy: subY, r: 4.5,
                    class: 'tree-commit tree-commit-branch tree-commit-origin',
                  }));
                  fDots.push(makeEl('circle', {
                    cx: f2, cy: subY + subH / 2, r: 4,
                    class: 'tree-commit tree-commit-branch',
                  }));
                  fDots.push(makeEl('circle', {
                    cx: f1, cy: subY + subH, r: 13,
                    class: 'tree-halo',
                  }));
                  fDots.push(makeEl('circle', {
                    cx: f1, cy: subY + subH, r: 8,
                    class: 'tree-commit tree-commit-branch tree-commit-merge',
                  }));
                  seq.push({ p: subP, dots: [], top: subY, bottom: subY + subH, len: spl });
                }
              }
            }

          seq.push({ p: path, dots: dots, top: absTop, bottom: absBottom, len: path ? pl : 0 });
          if (cy < firstY) firstY = cy;
          if (cy > lastY) lastY = cy;
        });

        S.appendChild(g);
        sects.push({ sec: sec, g: g, seq: seq, firstY: firstY, lastY: lastY });
        if (firstY < minY) minY = firstY;
        if (lastY > maxY) maxY = lastY;
      });

      if (!isFinite(minY)) return;

      var heroG = makeEl('g', { class: 'tree-group' });
      var heroSeq = [];

      heroSeq.push({
        p: null,
        top: 30,
        bottom: 30,
        len: 0,
        dots: [makeEl('circle', {
          cx: centerX, cy: 30, r: 5,
          class: 'tree-commit tree-commit-trunk',
        })],
      });

      function capsuleBranch(top, bottom, side, cy) {
        var lane = centerX + side * 28;
        var cRun = Math.abs(lane - centerX);
        var cTurn = Math.max(22, Math.min(58, cRun * 1.2));
        var cA = cTurn * 0.5;
        var p = makeEl('path', {
          d:
            'M ' + centerX + ' ' + top +
            ' C ' + centerX + ' ' + (top + cA) +
            ', ' + lane + ' ' + (top + cTurn - cA) +
            ', ' + lane + ' ' + (top + cTurn) +
            ' L ' + lane + ' ' + (bottom - cTurn) +
            ' C ' + lane + ' ' + (bottom - cTurn + cA) +
            ', ' + centerX + ' ' + (bottom - cA) +
            ', ' + centerX + ' ' + bottom,
          class: 'tree-branch',
        });
        var pl = p.getTotalLength();
        p.style.strokeDasharray = String(pl);
        p.style.strokeDashoffset = String(pl);
        return {
          p: p,
          top: top,
          bottom: bottom,
          len: pl,
          dots: [
            makeEl('circle', {
              cx: centerX, cy: top, r: 4.5,
              class: 'tree-commit tree-commit-branch tree-commit-origin',
            }),
            makeEl('circle', {
              cx: lane, cy: cy, r: 5,
              class: 'tree-commit tree-commit-branch',
            }),
            makeEl('circle', {
              cx: centerX, cy: bottom, r: 12,
              class: 'tree-halo tree-halo-cyan',
            }),
            makeEl('circle', {
              cx: centerX, cy: bottom, r: 7,
              class: 'tree-commit tree-commit-branch tree-commit-merge tree-commit-merge-cyan',
            }),
          ],
        };
      }

      heroSeq.push(capsuleBranch(56, 214, 1, 108));
      heroSeq.push(capsuleBranch(80, 214, -1, 146));
      heroSeq.push(capsuleBranch(650, 828, 1, 716));
      heroSeq.push(capsuleBranch(668, 856, -1, 762));
      heroSeq.push(capsuleBranch(760, 894, 1, 820));

      S.appendChild(heroG);
      sects.unshift({ sec: sections[0], g: heroG, seq: heroSeq });

      var trunkPath = makeEl('path', {
        d: 'M ' + centerX + ' 24 L ' + centerX + ' ' + (maxY + 60),
        class: 'tree-trunk',
      });
      var trunkLen = trunkPath.getTotalLength();
      trunkPath.style.strokeDasharray = String(trunkLen);
      trunkPath.style.strokeDashoffset = String(trunkLen);
      heroSeq.push({ p: trunkPath, top: 24, bottom: maxY + 60, len: trunkLen, dots: [] });

      function drawAll() {
        sects.forEach(function (pair) {
          pair.seq.forEach(function (s) {
            if (s.p) s.p.style.strokeDashoffset = '0';
            s.dots.forEach(function (d) {
              d.style.opacity = '1';
            });
          });
        });
      }

      function scrub() {
        var vh = window.innerHeight;
        var sy = window.scrollY;
        var front = sy + vh * 0.55;
        sects.forEach(function (pair) {
          pair.seq.forEach(function (s) {
            var h = s.bottom - s.top;
            var p = h > 0 ? (front - s.top) / h : (front > s.top ? 1 : 0);
            if (p < 0) p = 0;
            if (p > 1) p = 1;
            if (s.p) {
              s.p.style.strokeDashoffset = String(s.len * (1 - p));
            }
            s.dots.forEach(function (d) {
              var y = parseFloat(d.getAttribute('cy'));
              if (!isFinite(y)) y = s.bottom;
              var on;
              if (d.classList.contains('tree-commit-merge') || d.classList.contains('tree-halo')) {
                on = front >= s.bottom;
              } else if (d.classList.contains('tree-commit-origin')) {
                on = front >= y - 12;
              } else {
                on = front >= y;
              }
              d.style.opacity = on ? '1' : '0';
            });
          });
        });
      }

      var ticking = false;
      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function () {
          scrub();
          ticking = false;
        });
      }

      if (reduce) {
        sects.forEach(function (p) {
          p.g.classList.add('in-view');
        });
        drawAll();
      } else {
        window.removeEventListener('scroll', onScroll);
        window.addEventListener('scroll', onScroll, { passive: true });
        scrub();
      }
    }

    build();

    window.addEventListener('resize', function () {
      build();
    });
    window.addEventListener('load', function () {
      build();
    });
    setTimeout(build, 800);
  })();
</script>