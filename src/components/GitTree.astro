---

<div class="tree" aria-hidden="true">
  <svg id="tree-svg" xmlns="http://www.w3.org/2000/svg"></svg>
</div>

<script is:inline>
  (function () {
    var svg = document.getElementById('tree-svg');
    if (!svg) return;
    var S = svg;
    var NS = 'http://www.w3.org/2000/svg';
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var trunk = null;
    var travel = null;
    var branches = [];
    var dots = [];

    function clamp(v, lo, hi) {
      return Math.max(lo, Math.min(hi, v));
    }

    function makeEl(name, attrs) {
      var el = document.createElementNS(NS, name);
      Object.keys(attrs).forEach(function (k) {
        el.setAttribute(k, attrs[k]);
      });
      S.appendChild(el);
      return el;
    }

    function build() {
      while (S.firstChild) S.removeChild(S.firstChild);
      trunk = null;
      travel = null;
      branches = [];
      dots = [];

      var w = Math.max(320, document.documentElement.clientWidth);
      var docH = document.documentElement.scrollHeight;
      S.setAttribute('width', String(w));
      S.setAttribute('height', String(docH));
      S.setAttribute('viewBox', '0 0 ' + w + ' ' + docH);

      var tx = Math.max(16, Math.round(w * 0.03));
      var sy = window.scrollY;

      trunk = makeEl('path', {
        d: 'M ' + tx + ' 0 L ' + tx + ' ' + docH,
        class: 'tree-trunk',
        pathLength: '1',
        'stroke-dasharray': '1',
      });

      travel = makeEl('circle', { cx: tx, cy: 60, r: 4, class: 'tree-travel' });

      var root = makeEl('circle', { cx: tx, cy: 56, r: 5, class: 'tree-dot tree-dot-root' });
      dots.push({ el: root, y: 56 });

      var stepY = docH > 2200 ? 300 : 200;
      for (var gy = 240; gy < docH; gy += stepY) {
        var nd = makeEl('circle', { cx: tx, cy: gy, r: 2.2, class: 'tree-dot tree-dot-node' });
        dots.push({ el: nd, y: gy });
      }

      var targets = Array.prototype.slice.call(
        document.querySelectorAll('section[data-tree]'),
        1
      );

      targets.forEach(function (sec, idx) {
        var secRect = sec.getBoundingClientRect();
        var cy = secRect.top + sy + secRect.height / 2;
        var eyebrow = sec.querySelector('.eyebrow');
        var tipX = tx + 8;
        var y = cy;
        if (eyebrow) {
          var er = eyebrow.getBoundingClientRect();
          y = er.top + sy + er.height / 2;
          tipX = Math.max(tx + 8, Math.round(er.left));
        } else {
          tipX = Math.max(tx + 8, Math.round(secRect.left));
        }
        var yStart = Math.max(120, y - 320);
        var tone = idx % 2 === 0 ? 'cyan' : 'violet';

        var path = makeEl('path', {
          d:
            'M ' + tx + ' ' + yStart +
            ' C ' + (tx + 96) + ' ' + yStart +
            ', ' + (tipX - 70) + ' ' + (y + 8) +
            ', ' + tipX + ' ' + y,
          class: 'tree-branch tree-branch-' + tone,
          pathLength: '1',
          'stroke-dasharray': '1',
        });

        var tip = makeEl('circle', {
          cx: tipX,
          cy: y,
          r: 4.5,
          class: 'tree-dot' + (tone === 'violet' ? ' tree-dot-violet' : ''),
        });
        branches.push({ el: path, y0: yStart, dot: tip });

        var node = makeEl('circle', {
          cx: tx,
          cy: yStart,
          r: 2.4,
          class: 'tree-dot tree-dot-node',
        });
        dots.push({ el: node, y: yStart });
      });
    }

    function drawAll() {
      if (!trunk) return;
      trunk.setAttribute('stroke-dashoffset', '0');
      if (travel) travel.setAttribute('opacity', '0.9');
      branches.forEach(function (b) {
        b.el.setAttribute('stroke-dashoffset', '0');
        b.dot.setAttribute('opacity', '1');
      });
      dots.forEach(function (d) {
        d.el.setAttribute('opacity', '1');
      });
    }

    function onScroll() {
      if (!trunk) return;
      var sy = window.scrollY;
      var vh = window.innerHeight;
      var docH = document.documentElement.scrollHeight;
      var total = Math.max(1, docH - vh);
      var p = clamp(sy / total, 0, 1);

      trunk.setAttribute('stroke-dashoffset', String(1 - p));
      if (travel) {
        var ty = clamp((p * docH) - 56, 56, docH);
        travel.setAttribute('cy', String(ty));
        travel.setAttribute('opacity', String(p > 0 ? 0.55 + 0.35 * p : 0.9));
      }
      branches.forEach(function (b) {
        var pb = clamp((sy + vh * 0.9 - b.y0) / (vh * 0.8), 0, 1);
        b.path.setAttribute('stroke-dashoffset', String(1 - pb));
        b.dot.setAttribute('opacity', String(clamp(pb * 1.6, 0, 1)));
      });
      dots.forEach(function (d) {
        var a = clamp((sy + vh * 0.9 - d.y) / 140, 0, 1);
        d.el.setAttribute('opacity', String(a));
      });
    }

    build();
    if (reduce) {
      drawAll();
      return;
    }

    onScroll();

    var ticking = false;
    function req() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        ticking = false;
        onScroll();
      });
    }

    window.addEventListener('scroll', req, { passive: true });
    window.addEventListener('resize', function () {
      build();
      req();
    });
    window.addEventListener('load', function () {
      build();
      req();
    });
    setTimeout(function () {
      build();
      req();
    }, 800);
  })();
</script>