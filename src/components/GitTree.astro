---

<div class="tree" aria-hidden="true">
  <svg id="tree-svg" xmlns="http://www.w3.org/2000/svg"></svg>
</div>

<script is:inline>
  (function () {
    var svg = document.getElementById('tree-svg');
    if (!svg) return;
    var S = svg;
    var NS = 'http://www.w3.org/2000/svg';
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function makeEl(name, attrs) {
      var el = document.createElementNS(NS, name);
      Object.keys(attrs).forEach(function (k) {
        el.setAttribute(k, attrs[k]);
      });
      S.appendChild(el);
      return el;
    }

    function easeOutCubic(t) {
      return 1 - Math.pow(1 - t, 3);
    }

    function build() {
      while (S.firstChild) S.removeChild(S.firstChild);

      var w = Math.max(320, document.documentElement.clientWidth);
      if (w < 1280) {
        S.style.display = 'none';
        return;
      }
      S.style.display = '';

      var docH = document.documentElement.scrollHeight;
      var sy = window.scrollY;

      S.setAttribute('width', String(w));
      S.setAttribute('height', String(docH));
      S.setAttribute('viewBox', '0 0 ' + w + ' ' + docH);

      var sections = Array.prototype.slice.call(
        document.querySelectorAll('section[data-tree]')
      );
      if (sections.length < 2) return;

      var centerX = w / 2;
      var sects = [];
      var minY = Infinity;
      var maxY = -Infinity;

      sections.forEach(function (sec, si) {
        if (si === 0) return;
        var cont = sec.querySelector('.container-x');
        if (!cont) return;
        var items = Array.prototype.filter.call(cont.children, function (el) {
          return el.hasAttribute('data-tree-anchor');
        });
        if (!items.length) return;

        var g = makeEl('g', { class: 'tree-group' });
        var seq = [];
        var firstY = Infinity;
        var lastY = -Infinity;

        items.forEach(function (item) {
          var r = item.getBoundingClientRect();
          var top = r.top + sy;
          var bot = r.bottom + sy;
          var cy = top + r.height / 2;
          var side = r.left + r.width / 2 < centerX ? -1 : 1;
          var laneX = centerX + side * 22;
          var edgeX = side < 0 ? r.right + 14 : r.left - 14;

          if (r.height < 200) {
            var tp = makeEl('path', {
              d: 'M ' + centerX + ' ' + cy + ' Q ' + (centerX + side * 24) + ' ' + cy + ' ' + edgeX + ' ' + cy,
              class: 'tree-branch',
            });
            var tpl = tp.getTotalLength();
            tp.style.strokeDasharray = String(tpl);
            tp.style.strokeDashoffset = String(tpl);
            seq.push({
              paths: [tp],
              dots: [
                makeEl('circle', { cx: centerX, cy: cy, r: 5, class: 'tree-commit tree-commit-trunk' }),
                makeEl('circle', { cx: edgeX, cy: cy, r: 3.5, class: 'tree-commit tree-commit-branch' }),
              ],
            });
          } else {
            var lp = makeEl('path', {
              d:
                'M ' + centerX + ' ' + top +
                ' C ' + (centerX + side * 16) + ' ' + top +
                ', ' + laneX + ' ' + (top + 8) +
                ', ' + laneX + ' ' + (top + 18) +
                ' L ' + laneX + ' ' + (bot - 18) +
                ' C ' + laneX + ' ' + (bot - 8) +
                ', ' + (centerX + side * 16) + ' ' + bot +
                ', ' + centerX + ' ' + bot,
              class: 'tree-branch',
            });
            var lpl = lp.getTotalLength();
            lp.style.strokeDasharray = String(lpl);
            lp.style.strokeDashoffset = String(lpl);

            var ep = makeEl('path', {
              d: 'M ' + laneX + ' ' + cy + ' Q ' + ((laneX + edgeX) / 2) + ' ' + cy + ' ' + edgeX + ' ' + cy,
              class: 'tree-branch',
            });
            var epl = ep.getTotalLength();
            ep.style.strokeDasharray = String(epl);
            ep.style.strokeDashoffset = String(epl);

            var ldots = [
              makeEl('circle', { cx: centerX, cy: top, r: 4.5, class: 'tree-commit tree-commit-trunk' }),
              makeEl('circle', { cx: laneX, cy: cy, r: 5, class: 'tree-commit tree-commit-branch' }),
              makeEl('circle', { cx: laneX, cy: bot, r: 4.5, class: 'tree-commit tree-commit-trunk' }),
            ];
            if (r.height >= 360) {
              ldots.push(makeEl('circle', { cx: laneX, cy: top + r.height * 0.32, r: 4, class: 'tree-commit tree-commit-branch' }));
              ldots.push(makeEl('circle', { cx: laneX, cy: bot - r.height * 0.32, r: 4, class: 'tree-commit tree-commit-branch' }));
            }
            ldots.push(makeEl('circle', { cx: edgeX, cy: cy, r: 3.5, class: 'tree-commit tree-commit-branch' }));

            seq.push({ paths: [lp, ep], dots: ldots });
          }
          if (cy < firstY) firstY = cy;
          if (cy > lastY) lastY = cy;
        });

        S.appendChild(g);
        sects.push({ sec: sec, g: g, seq: seq, firstY: firstY, lastY: lastY });
        if (firstY < minY) minY = firstY;
        if (lastY > maxY) maxY = lastY;
      });

      if (!isFinite(minY)) return;

      makeEl('path', {
        d: 'M ' + centerX + ' ' + (minY - 40) + ' L ' + centerX + ' ' + (maxY + 60),
        class: 'tree-trunk',
      });

      function drawAll() {
        sects.forEach(function (pair) {
          pair.seq.forEach(function (s) {
            s.paths.forEach(function (pp) {
              pp.style.strokeDashoffset = '0';
            });
            s.dots.forEach(function (d) {
              d.style.opacity = '1';
            });
          });
        });
      }

      if (reduce || !('IntersectionObserver' in window)) {
        sects.forEach(function (p) {
          p.g.classList.add('in-view');
        });
        drawAll();
        return;
      }

      var obs = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (en) {
            if (!en.isIntersecting) return;
            var hit = null;
            sects.forEach(function (p) {
              if (p.sec === en.target) hit = p;
            });
            if (!hit) return;
            hit.g.classList.add('in-view');
            obs.unobserve(en.target);

            hit.seq.forEach(function (s, i) {
              s.paths.forEach(function (pp, pi) {
                setTimeout(function () {
                  var from = parseFloat(pp.style.strokeDashoffset);
                  var start = null;
                  function tick(now) {
                    if (start === null) start = now;
                    var t = Math.min(1, (now - start) / 700);
                    pp.style.strokeDashoffset = String(from * (1 - easeOutCubic(t)));
                    if (t < 1) {
                      requestAnimationFrame(tick);
                    } else if (pi === s.paths.length - 1) {
                      s.dots.forEach(function (d, j) {
                        setTimeout(function () {
                          d.style.opacity = '1';
                        }, 120 + j * 110);
                      });
                    }
                  }
                  requestAnimationFrame(tick);
                }, i * 160 + pi * 200);
              });
            });
          });
        },
        { threshold: 0.2 }
      );

      sects.forEach(function (p) {
        obs.observe(p.sec);
      });
    }

    build();

    window.addEventListener('resize', function () {
      build();
    });
    window.addEventListener('load', function () {
      build();
    });
    setTimeout(build, 800);
  })();
</script>