---

---

<div class="tree" aria-hidden="true">
  <svg id="tree-svg" xmlns="http://www.w3.org/2000/svg"></svg>
</div>

<script is:inline>
  (function () {
    var svg = document.getElementById('tree-svg');
    if (!svg) return;
    var S = svg;
    var NS = 'http://www.w3.org/2000/svg';
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function makeEl(name, attrs) {
      var el = document.createElementNS(NS, name);
      Object.keys(attrs).forEach(function (k) {
        el.setAttribute(k, attrs[k]);
      });
      S.appendChild(el);
      return el;
    }

    function easeOutCubic(t) {
      return 1 - Math.pow(1 - t, 3);
    }

    function cluster(ys, tol) {
      ys.sort(function (a, b) { return a - b; });
      var out = [];
      var cur = [ys[0]];
      for (var i = 1; i < ys.length; i += 1) {
        if (ys[i] - cur[cur.length - 1] < tol) {
          cur.push(ys[i]);
        } else {
          out.push(cur.reduce(function (s, v) { return s + v; }, 0) / cur.length);
          cur = [ys[i]];
        }
      }
      out.push(cur.reduce(function (s, v) { return s + v; }, 0) / cur.length);
      return out;
    }

    function build() {
      while (S.firstChild) S.removeChild(S.firstChild);

      var w = Math.max(320, document.documentElement.clientWidth);
      if (w < 1280) {
        S.style.display = 'none';
        return;
      }
      S.style.display = '';

      var docH = document.documentElement.scrollHeight;
      var sy = window.scrollY;

      S.setAttribute('width', String(w));
      S.setAttribute('height', String(docH));
      S.setAttribute('viewBox', '0 0 ' + w + ' ' + docH);

      var sections = Array.prototype.slice.call(
        document.querySelectorAll('section[data-tree]')
      );
      if (sections.length < 2) return;

      var centerX = w / 2;
      var sects = [];
      var minY = Infinity;
      var maxY = -Infinity;

      sections.forEach(function (sec, si) {
        if (si === 0) return;
        var cont = sec.querySelector('.container-x');
        if (!cont) return;
        var items = Array.prototype.filter.call(cont.children, function (el) {
          return el.hasAttribute('data-tree-anchor');
        });
        if (!items.length) return;

        var g = makeEl('g', { class: 'tree-group' });
        var seq = [];
        var firstY = Infinity;
        var lastY = -Infinity;

        items.forEach(function (item) {
          var r = item.getBoundingClientRect();
          var absTop = r.top + sy;
          var absBottom = r.bottom + sy;
          var h = item.offsetHeight;
          var cy = absTop + h / 2;

          var dots = [];
          dots.push(makeEl('circle', {
            cx: centerX, cy: cy, r: 5,
            class: 'tree-commit tree-commit-trunk',
          }));

          var path = null;
          var lane = null;

          if (h > 110) {
            var side = r.left + r.width / 2 < centerX ? -1 : 1;
            var edge = side < 0 ? r.left + r.width : r.left;
            lane = edge - side * 18;

            var cRun = Math.abs(lane - centerX);
            var cTurn = Math.max(22, Math.min(58, cRun * 1.2));
            var cA = cTurn * 0.5;

            path = makeEl('path', {
              d:
                'M ' + centerX + ' ' + absTop +
                ' C ' + centerX + ' ' + (absTop + cA) +
                ', ' + lane + ' ' + (absTop + cTurn - cA) +
                ', ' + lane + ' ' + (absTop + cTurn) +
                ' L ' + lane + ' ' + (absBottom - cTurn) +
                ' C ' + lane + ' ' + (absBottom - cTurn + cA) +
                ', ' + centerX + ' ' + (absBottom - cA) +
                ', ' + centerX + ' ' + absBottom,
              class: 'tree-branch',
            });
            var pl = path.getTotalLength();
            path.style.strokeDasharray = String(pl);
            path.style.strokeDashoffset = String(pl);

            var subs = Array.prototype.slice.call(
              item.querySelectorAll('h2, h3, h4')
            ).map(function (el) {
              var cr = el.getBoundingClientRect();
              return cr.top + sy + cr.height / 2;
            });
            if (subs.length) {
              subs = cluster(subs, 90).filter(function (y) {
                return y >= absTop + cTurn + 10 && y <= absBottom - cTurn - 10;
              });
            }
            if (!subs.length) subs = [cy];
            subs.forEach(function (y) {
              dots.push(makeEl('circle', {
                cx: lane, cy: y, r: 5,
                class: 'tree-commit tree-commit-branch',
              }));
            });

            if (item.tagName === 'ARTICLE') {
              var featSide = r.left + r.width / 2 <= centerX ? 1 : -1;
              var fyT = absTop + 60;
              var fyB = absBottom - 40;
              var seg = fyB - fyT;

              if (seg > 160) {
                var contRect = cont.getBoundingClientRect();
                var voxL = contRect.left;
                var voxR = contRect.left + contRect.width;
                var cardL = r.left;
                var cardR = r.left + r.width;
                var voidW = featSide > 0 ? voxR - cardR : cardL - voxL;

                if (voidW < 140) {
                  f1 = centerX + featSide * 60;
                  f2 = centerX + featSide * 110;
                } else {
                  f1 = featSide > 0
                    ? cardR + voidW * 0.16
                    : cardL - voidW * 0.16;
                  f2 = featSide > 0
                    ? cardR + voidW * 0.24
                    : cardL - voidW * 0.24;
                }

                // La rama y el tronco deben quedar AMBOS del mismo lado de la tarjeta.
                // Forzar f1/f2 al lado del producto del tronco (no cruzar el tronco).
                var fDir = f1 > centerX ? 1 : -1;
                var runX = Math.abs(f1 - centerX);
                var turnY = Math.max(58, Math.min(150, runX * 1.4));
                var arcA = turnY * 0.5;

                var mainP = makeEl('path', {
                  d:
                    'M ' + centerX + ' ' + fyT +
                    ' C ' + centerX + ' ' + (fyT + arcA) +
                    ', ' + f1 + ' ' + (fyT + turnY - arcA) +
                    ', ' + f1 + ' ' + (fyT + turnY) +
                    ' L ' + f1 + ' ' + (fyB - turnY) +
                    ' C ' + f1 + ' ' + (fyB - turnY + arcA) +
                    ', ' + centerX + ' ' + (fyB - arcA) +
                    ', ' + centerX + ' ' + fyB,
                  class: 'tree-branch tree-branch-feature',
                });
                var mpl = mainP.getTotalLength();
                mainP.style.strokeDasharray = String(mpl);
                mainP.style.strokeDashoffset = String(mpl);

                var fDotTop = fyT + turnY + 12;
                var fDotBot = fyB - turnY - 12;
                var fDotSeg = fDotBot - fDotTop;
                var fDots = [];
                if (fDotSeg > 40) {
                  var mainYs = [];
                  for (var mk = 1; mk <= 6; mk += 1) {
                    mainYs.push(fDotTop + (fDotSeg * mk) / 7);
                  }
                  mainYs.forEach(function (y) {
                    fDots.push(makeEl('circle', {
                      cx: f1, cy: y, r: 4.5,
                      class: 'tree-commit tree-commit-branch tree-commit-feature',
                    }));
                  });
                }

                seq.push({ p: mainP, dots: fDots });

                fDots.push(makeEl('circle', {
                  cx: centerX, cy: fyT, r: 3,
                  class: 'tree-commit tree-commit-trunk',
                }));
                fDots.push(makeEl('circle', {
                  cx: centerX, cy: fyB, r: 3,
                  class: 'tree-commit tree-commit-trunk',
                }));

                var subYs = [fyT + seg * 0.34, fyT + seg * 0.66];
                subYs.forEach(function (fyy) {
                  var subRun = Math.abs(f2 - f1);
                  var subTurn = Math.max(40, Math.min(84, subRun * 1.2));
                  var subA = subTurn * 0.5;
                  var subH = 200;
                  var subP = makeEl('path', {
                    d:
                      'M ' + f1 + ' ' + fyy +
                      ' C ' + f1 + ' ' + (fyy + subA) +
                      ', ' + f2 + ' ' + (fyy + subTurn - subA) +
                      ', ' + f2 + ' ' + (fyy + subTurn) +
                      ' L ' + f2 + ' ' + (fyy + subH - subTurn) +
                      ' C ' + f2 + ' ' + (fyy + subH - subTurn + subA) +
                      ', ' + f1 + ' ' + (fyy + subH - subA) +
                      ', ' + f1 + ' ' + (fyy + subH),
                    class: 'tree-branch tree-branch-feature tree-branch-feature-sub',
                  });
                  var spl = subP.getTotalLength();
                  subP.style.strokeDashoffset = String(spl);
                  fDots.push(makeEl('circle', {
                    cx: f2, cy: fyy + subH / 2, r: 4,
                    class: 'tree-commit tree-commit-branch tree-commit-feature',
                  }));
                  seq.push({ p: subP, dots: [] });
                });

              }
            }
          }

          seq.push({ p: path, dots: dots });
          if (cy < firstY) firstY = cy;
          if (cy > lastY) lastY = cy;
        });

        S.appendChild(g);
        sects.push({ sec: sec, g: g, seq: seq, firstY: firstY, lastY: lastY });
        if (firstY < minY) minY = firstY;
        if (lastY > maxY) maxY = lastY;
      });

      if (!isFinite(minY)) return;

      var heroG = makeEl('g', { class: 'tree-group' });
      var heroSeq = [];

      heroSeq.push({
        p: null,
        dots: [makeEl('circle', {
          cx: centerX, cy: 30, r: 5,
          class: 'tree-commit tree-commit-trunk',
        })],
      });

      function capsuleBranch(top, bottom, side, cy) {
        var lane = centerX + side * 38;
        var cRun = Math.abs(lane - centerX);
        var cTurn = Math.max(22, Math.min(58, cRun * 1.2));
        var cA = cTurn * 0.5;
        var p = makeEl('path', {
          d:
            'M ' + centerX + ' ' + top +
            ' C ' + centerX + ' ' + (top + cA) +
            ', ' + lane + ' ' + (top + cTurn - cA) +
            ', ' + lane + ' ' + (top + cTurn) +
            ' L ' + lane + ' ' + (bottom - cTurn) +
            ' C ' + lane + ' ' + (bottom - cTurn + cA) +
            ', ' + centerX + ' ' + (bottom - cA) +
            ', ' + centerX + ' ' + bottom,
          class: 'tree-branch',
        });
        var pl = p.getTotalLength();
        p.style.strokeDasharray = String(pl);
        p.style.strokeDashoffset = String(pl);
        var junc = makeEl('circle', {
          cx: centerX, cy: top, r: 2.5,
          class: 'tree-commit tree-commit-trunk',
        });
        return {
          p: p,
          dots: [
            junc,
            makeEl('circle', {
              cx: lane, cy: cy, r: 5,
              class: 'tree-commit tree-commit-branch',
            }),
          ],
        };
      }

      heroSeq.push(capsuleBranch(56, 214, 1, 108));
      heroSeq.push(capsuleBranch(80, 214, -1, 146));
      heroSeq.push(capsuleBranch(650, 828, 1, 716));
      heroSeq.push(capsuleBranch(668, 856, -1, 762));
      heroSeq.push(capsuleBranch(760, 894, 1, 820));

      S.appendChild(heroG);
      sects.unshift({ sec: sections[0], g: heroG, seq: heroSeq });

      makeEl('path', {
        d: 'M ' + centerX + ' 24 L ' + centerX + ' ' + (maxY + 60),
        class: 'tree-trunk',
      });

      function drawAll() {
        sects.forEach(function (pair) {
          pair.seq.forEach(function (s) {
            if (s.p) s.p.style.strokeDashoffset = '0';
            s.dots.forEach(function (d) {
              d.style.opacity = '1';
            });
          });
        });
      }

      if (reduce || !('IntersectionObserver' in window)) {
        sects.forEach(function (p) {
          p.g.classList.add('in-view');
        });
        drawAll();
        return;
      }

      var obs = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (en) {
            if (!en.isIntersecting) return;
            var hit = null;
            sects.forEach(function (p) {
              if (p.sec === en.target) hit = p;
            });
            if (!hit) return;
            hit.g.classList.add('in-view');
            obs.unobserve(en.target);

            hit.seq.forEach(function (s, i) {
              if (s.p) {
                setTimeout(function () {
                  var from = parseFloat(s.p.style.strokeDashoffset);
                  var start = null;
                  function tick(now) {
                    if (start === null) start = now;
                    var t = Math.min(1, (now - start) / 800);
                    s.p.style.strokeDashoffset = String(from * (1 - easeOutCubic(t)));
                    if (t < 1) {
                      requestAnimationFrame(tick);
                    } else {
                      s.dots.forEach(function (d, j) {
                        setTimeout(function () {
                          d.style.opacity = '1';
                        }, 100 + j * 110);
                      });
                    }
                  }
                  requestAnimationFrame(tick);
                }, i * 140);
              } else {
                setTimeout(function () {
                  s.dots.forEach(function (d, j) {
                    setTimeout(function () {
                      d.style.opacity = '1';
                    }, j * 90);
                  });
                }, i * 140);
              }
            });
          });
        },
        { threshold: 0, rootMargin: '0px 0px 400px 0px' }
      );

      sects.forEach(function (p) {
        obs.observe(p.sec);
      });
    }

    build();

    window.addEventListener('resize', function () {
      build();
    });
    window.addEventListener('load', function () {
      build();
    });
    setTimeout(build, 800);
  })();
</script>