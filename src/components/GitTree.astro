---

---

<div class="tree" aria-hidden="true">
  <svg id="tree-svg" xmlns="http://www.w3.org/2000/svg"></svg>
</div>

<script is:inline>
  (function () {
    var svg = document.getElementById('tree-svg');
    if (!svg) return;
    var S = svg;
    var NS = 'http://www.w3.org/2000/svg';
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function makeEl(name, attrs) {
      var el = document.createElementNS(NS, name);
      Object.keys(attrs).forEach(function (k) {
        el.setAttribute(k, attrs[k]);
      });
      S.appendChild(el);
      return el;
    }

    function easeOutCubic(t) {
      return 1 - Math.pow(1 - t, 3);
    }

    function animateDraw(path, duration, delayMs, commitDots) {
      setTimeout(function () {
        var from = parseFloat(path.style.strokeDashoffset);
        var start = null;
        function tick(now) {
          if (start === null) start = now;
          var t = Math.min(1, (now - start) / duration);
          path.style.strokeDashoffset = String(from * (1 - easeOutCubic(t)));
          if (t < 1) {
            requestAnimationFrame(tick);
          } else {
            commitDots.forEach(function (dot, i) {
              setTimeout(function () {
                dot.style.opacity = '1';
              }, 150 + i * 160);
            });
          }
        }
        requestAnimationFrame(tick);
      }, delayMs);
    }

    function build() {
      while (S.firstChild) S.removeChild(S.firstChild);

      var w = Math.max(320, document.documentElement.clientWidth);
      var docH = document.documentElement.scrollHeight;
      var sy = window.scrollY;

      var sections = Array.prototype.slice.call(
        document.querySelectorAll('section[data-tree]')
      );
      if (!sections.length) return;

      var cont = sections[0].querySelector('.container-x');
      var contLeft = cont ? cont.getBoundingClientRect().left : Math.round(w * 0.08);

      var trunkX = Math.round(contLeft - 48);
      var apexX = Math.round(contLeft - 16);

      if (trunkX < 24) {
        S.style.display = 'none';
        return;
      }
      S.style.display = '';

      S.setAttribute('width', String(w));
      S.setAttribute('height', String(docH));
      S.setAttribute('viewBox', '0 0 ' + w + ' ' + docH);

      makeEl('path', {
        d: 'M ' + trunkX + ' 0 L ' + trunkX + ' ' + docH,
        class: 'tree-trunk',
      });

      var pairs = [];

      var hero = makeEl('g', { class: 'tree-group' });
      var heroCommits = [
        makeEl('circle', { cx: trunkX, cy: 64, r: 5, class: 'tree-commit tree-commit-trunk' }),
        makeEl('circle', { cx: trunkX, cy: 170, r: 4.5, class: 'tree-commit tree-commit-trunk' }),
      ];
      S.appendChild(hero);
      pairs.push({ sec: sections[0], g: hero, path: null, dots: heroCommits });

      sections.slice(1).forEach(function (sec, idx) {
        var r = sec.getBoundingClientRect();
        var top = r.top + sy;
        var h = r.height;

        var g = makeEl('g', { class: 'tree-group' });
        var path = null;
        var dots = [];

        var y1 = top + 90;
        var dy = Math.min(360, Math.max(200, h - 180));
        var y2 = y1 + dy;
        var q = 60;

        path = makeEl('path', {
          d:
            'M ' + trunkX + ' ' + y1 +
            ' C ' + (trunkX + 60) + ' ' + y1 +
            ', ' + apexX + ' ' + (y1 + q) +
            ', ' + apexX + ' ' + (y1 + q + 40) +
            ' L ' + apexX + ' ' + (y2 - q - 40) +
            ' C ' + apexX + ' ' + (y2 - q) +
            ', ' + (trunkX + 60) + ' ' + y2 +
            ', ' + trunkX + ' ' + y2,
          class: 'tree-branch tree-draw',
        });
        var pl = path.getTotalLength();
        path.style.strokeDasharray = String(pl);
        path.style.strokeDashoffset = String(pl);

        var n = 3;
        for (var c = 1; c <= n; c += 1) {
          var cyc = y1 + q + 40 + (c * (y2 - y1 - 2 * (q + 40))) / (n + 1);
          dots.push(makeEl('circle', {
            cx: apexX,
            cy: cyc,
            r: 5,
            class: 'tree-commit tree-commit-branch',
          }));
        }

        var birth = makeEl('circle', {
          cx: trunkX, cy: y1, r: 4.5,
          class: 'tree-commit tree-commit-trunk',
        });
        var trunkDot = makeEl('circle', {
          cx: trunkX, cy: top - 50, r: 4.5,
          class: 'tree-commit tree-commit-trunk',
        });

        S.appendChild(g);
        pairs.push({ sec: sec, g: g, path: path, dots: dots.concat([birth, trunkDot]) });
      });

      var tail = makeEl('g', { class: 'tree-group' });
      var tailDot = makeEl('circle', {
        cx: trunkX, cy: docH - 90, r: 4.5,
        class: 'tree-commit tree-commit-trunk',
      });
      S.appendChild(tail);
      pairs.push({ sec: sections[sections.length - 1], g: tail, path: null, dots: [tailDot] });

      function drawAll() {
        pairs.forEach(function (p) {
          if (p.path) {
            p.path.style.strokeDashoffset = '0';
          }
          p.dots.forEach(function (d) {
            d.style.opacity = '1';
          });
        });
      }

      if (reduce || !('IntersectionObserver' in window)) {
        pairs.forEach(function (p) {
          p.g.classList.add('in-view');
        });
        drawAll();
        return;
      }

      var obs = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (en) {
            if (!en.isIntersecting) return;
            var hit = null;
            pairs.forEach(function (p) {
              if (p.sec === en.target) hit = p;
            });
            if (!hit) return;
            hit.g.classList.add('in-view');
            obs.unobserve(en.target);
            if (hit.path) {
              var delay = idxParity(hit) ? 0 : 220;
              animateDraw(hit.path, 1150, delay, hit.dots);
            } else {
              hit.dots.forEach(function (d, i) {
                setTimeout(function () {
                  d.style.opacity = '1';
                }, 150 + i * 180);
              });
            }
          });
        },
        { threshold: 0.2 }
      );
      pairs.forEach(function (p) {
        obs.observe(p.sec);
      });

      function idxParity(p) {
        var i = pairs.indexOf(p);
        return i % 2 === 1;
      }
    }

    build();

    window.addEventListener('resize', function () {
      build();
    });
    window.addEventListener('load', function () {
      build();
    });
    setTimeout(build, 800);
  })();
</script>