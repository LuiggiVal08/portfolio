---

<div class="tree" aria-hidden="true">
  <svg id="tree-svg" xmlns="http://www.w3.org/2000/svg"></svg>
</div>

<script is:inline>
  (function () {
    var svg = document.getElementById('tree-svg');
    if (!svg) return;
    var S = svg;
    var NS = 'http://www.w3.org/2000/svg';
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function makeEl(name, attrs) {
      var el = document.createElementNS(NS, name);
      Object.keys(attrs).forEach(function (k) {
        el.setAttribute(k, attrs[k]);
      });
      S.appendChild(el);
      return el;
    }

    function easeOutCubic(t) {
      return 1 - Math.pow(1 - t, 3);
    }

    function build() {
      while (S.firstChild) S.removeChild(S.firstChild);

      var w = Math.max(320, document.documentElement.clientWidth);
      if (w < 1280) {
        S.style.display = 'none';
        return;
      }
      S.style.display = '';

      var docH = document.documentElement.scrollHeight;
      var sy = window.scrollY;

      var sections = Array.prototype.slice.call(
        document.querySelectorAll('section[data-tree]')
      );
      if (sections.length < 2) return;

      var centerX = w / 2;
      var pairs = [];
      var minY = Infinity;
      var maxY = -Infinity;

      sections.forEach(function (sec, si) {
        if (si === 0) return;
        var cont = sec.querySelector('.container-x');
        if (!cont) return;
        var items = Array.prototype.filter.call(cont.children, function (el) {
          return el.hasAttribute('data-tree-anchor');
        });
        if (!items.length) return;

        var g = makeEl('g', { class: 'tree-group' });
        var seq = [];

        items.forEach(function (item) {
          var r = item.getBoundingClientRect();
          var cy = r.top + sy + r.height / 2;
          var side = r.left + r.width / 2 < centerX ? -1 : 1;
          var edgeX = side < 0 ? r.right + 14 : r.left - 14;
          var ctrl = centerX + side * Math.min(30, Math.abs(edgeX - centerX) * 0.45);

          var p = makeEl('path', {
            d: 'M ' + centerX + ' ' + cy + ' Q ' + ctrl + ' ' + cy + ' ' + edgeX + ' ' + cy,
            class: 'tree-branch',
          });
          var pl = p.getTotalLength();
          p.style.strokeDasharray = String(pl);
          p.style.strokeDashoffset = String(pl);

          var trunkDot = makeEl('circle', {
            cx: centerX, cy: cy, r: 5,
            class: 'tree-commit tree-commit-trunk',
          });
          var edgeDot = makeEl('circle', {
            cx: edgeX, cy: cy, r: 4,
            class: 'tree-commit tree-commit-branch',
          });

          seq.push({ p: p, dots: [trunkDot, edgeDot] });
          if (r.top + sy < minY) minY = r.top + sy;
          if (r.bottom + sy > maxY) maxY = r.bottom + sy;
        });

        S.appendChild(g);
        pairs.push({ sec: sec, g: g, seq: seq });
      });

      if (!isFinite(minY)) return;

      makeEl('path', {
        d: 'M ' + centerX + ' ' + (minY - 40) + ' L ' + centerX + ' ' + (maxY + 60),
        class: 'tree-trunk',
      });

      function drawAll() {
        pairs.forEach(function (pair) {
          pair.seq.forEach(function (s) {
            s.p.style.strokeDashoffset = '0';
            s.dots.forEach(function (d) {
              d.style.opacity = '1';
            });
          });
        });
      }

      if (reduce || !('IntersectionObserver' in window)) {
        pairs.forEach(function (p) {
          p.g.classList.add('in-view');
        });
        drawAll();
        return;
      }

      var obs = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (en) {
            if (!en.isIntersecting) return;
            var hit = null;
            pairs.forEach(function (p) {
              if (p.sec === en.target) hit = p;
            });
            if (!hit) return;
            hit.g.classList.add('in-view');
            obs.unobserve(en.target);

            hit.seq.forEach(function (s, i) {
              setTimeout(function () {
                var from = parseFloat(s.p.style.strokeDashoffset);
                var start = null;
                function tick(now) {
                  if (start === null) start = now;
                  var t = Math.min(1, (now - start) / 700);
                  s.p.style.strokeDashoffset = String(from * (1 - easeOutCubic(t)));
                  if (t < 1) {
                    requestAnimationFrame(tick);
                  } else {
                    s.dots.forEach(function (d, j) {
                      setTimeout(function () {
                        d.style.opacity = '1';
                      }, 120 + j * 110);
                    });
                  }
                }
                requestAnimationFrame(tick);
              }, i * 160);
            });
          });
        },
        { threshold: 0.2 }
      );

      pairs.forEach(function (p) {
        obs.observe(p.sec);
      });
    }

    build();

    window.addEventListener('resize', function () {
      build();
    });
    window.addEventListener('load', function () {
      build();
    });
    setTimeout(build, 800);
  })();
</script>