---
import type { UI } from '../i18n';

interface Props {
  ui: UI;
}

const { ui } = Astro.props;

const rows = [
  { gutter: '*', hash: '8d596ae', msg: 'fix: título ES de la sección Misión', tag: 'main', tone: 'cyan' },
  { gutter: '*', hash: '66c99a4', msg: 'feat: reposicionar OdalX como laboratorio', tag: 'main', tone: 'cyan' },
  { gutter: '*', hash: '36843f5', msg: 'feat: avatar de GitHub en el hero', tag: 'main', tone: 'cyan' },
  { gutter: '*', hash: '8d93f8e', msg: 'feat: portfolio OdalX — Astro bilingüe', tag: 'main', tone: 'cyan' },
  { gutter: '|\\' },
  { gutter: '| *', hash: 'c5e0a89', msg: 'Merge PR #23 — data sources', tag: 'argos-ats', tone: 'violet' },
  { gutter: '| *', hash: '9e7b604', msg: 'feat(data-engine): h30-001 FundingRate, OpenInterest', tag: 'argos-ats', tone: 'violet' },
  { gutter: '| *', hash: 'db921bf', msg: 'feat(analytics-engine): Q02 Signal Validation', tag: 'argos-ats', tone: 'violet' },
  { gutter: '|/' },
  { gutter: '*', hash: '3177ac2', msg: 'fix(security): viewer XSS + deps', tag: 'toon-memory', tone: 'violet' },
  { gutter: '*', hash: 'fe2aea7', msg: 'feat(packaging): ~14x smaller npm install', tag: 'toon-memory', tone: 'violet' },
  { gutter: '*', hash: 'a1e5dc0', msg: 'feat(docs): 22 agents + 7 logos', tag: 'toon-memory', tone: 'violet' },
  { gutter: '|' },
  { gutter: '*', hash: '(working tree)', msg: 'Atrio — núcleo ERP multi-tenant', tag: 'atrio-erp', tone: 'cyan' },
];
---

<section id="arbol" class="scroll-mt-28 py-24 sm:py-32">
  <div class="container-x">
    <div class="mb-14 max-w-2xl" data-reveal>
      <p class="eyebrow">{ui.gitgraph.kicker}</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">
        {ui.gitgraph.title}
      </h2>
      <p class="mt-3 max-w-xl text-slate-600 dark:text-slate-300">{ui.gitgraph.subtitle}</p>
    </div>

    <div class="term" data-reveal aria-label="git log --graph">
      <div class="term-bar">
        <span class="term-dot term-dot-r"></span>
        <span class="term-dot term-dot-y"></span>
        <span class="term-dot term-dot-g"></span>
        <span class="term-title">odalx@github:~/workspace</span>
      </div>
      <div class="term-body gitlog">
        <p class="gitlog-prompt">
          <span class="term-prompt">odalx@github:~$</span> git log --graph --all --oneline
        </p>
        {
          rows.map((row, i) => (
            row.hash ? (
              <div
                class="gitlog-row"
                data-reveal
                style={`transition-delay: ${i * 70}ms`}
              >
                <span class="gitlog-gutter">{row.gutter}</span>
                <span class={`gitlog-dot${row.tone === 'violet' ? ' gitlog-dot-violet' : ''}`}></span>
                <span class="gitlog-hash">{row.hash}</span>
                <span class="gitlog-msg">{row.msg}</span>
                <span class={`gitlog-tag hidden sm:inline-block${row.tone === 'violet' ? ' gitlog-tag-violet' : ''}`}>
                  {row.tag}
                </span>
              </div>
            ) : (
              <div class="gitlog-row" data-reveal style={`transition-delay: ${i * 70}ms`}>
                <span class="gitlog-gutter">{row.gutter}</span>
              </div>
            )
          ))
        }
        <span class="term-prompt">odalx@github:~$</span> <span class="cursor" aria-hidden="true"></span>
      </div>
    </div>
  </div>
</section>
